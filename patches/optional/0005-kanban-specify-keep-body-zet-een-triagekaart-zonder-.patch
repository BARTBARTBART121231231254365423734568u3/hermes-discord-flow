diff --git a/hermes_cli/kanban_specify.py b/hermes_cli/kanban_specify.py
index b0a7412cb1..e7b105f5bd 100644
--- a/hermes_cli/kanban_specify.py
+++ b/hermes_cli/kanban_specify.py
@@ -233,6 +233,19 @@ def specify_task(
     return SpecifyOutcome(task_id, True, "specified", new_title=new_title)
 
 
+def promote_keep_body(task_id: str, *, author: Optional[str] = None) -> SpecifyOutcome:
+    """``specify --keep-body``: ``triage -> todo`` with title and body
+    untouched and no LLM call; the block-loop counter starts afresh."""
+    task, reason = _load_triage_task(task_id)
+    if task is None:
+        return SpecifyOutcome(task_id, False, reason)
+    with kbc.connect_closing() as conn:
+        ok = kb.specify_triage_task(conn, task_id, author=author or _profile_author(), reset_block_loop=True)
+    if not ok:
+        return SpecifyOutcome(task_id, False, "task moved out of triage before promotion")
+    return SpecifyOutcome(task_id, True, "specified (body kept)")
+
+
 def list_triage_ids(*, tenant: Optional[str] = None) -> list[str]:
     """Task ids in the triage column; ``tenant`` narrows the sweep."""
     with kbc.connect_closing() as conn:
diff --git a/tests/hermes_cli/test_kanban_specify.py b/tests/hermes_cli/test_kanban_specify.py
index 55f1d33d52..b353f826e4 100644
--- a/tests/hermes_cli/test_kanban_specify.py
+++ b/tests/hermes_cli/test_kanban_specify.py
@@ -139,3 +139,79 @@ def test_cli_specify_tenant_filter(kanban_home, capsys):
         assert kb.get_task(conn, inside).status in {"todo", "ready"}
 
 
+
+
+# ---------------------------------------------------------------------------
+# ``specify --keep-body`` (no LLM, loop counter reset)
+# ---------------------------------------------------------------------------
+
+def _no_llm():
+    return patch("agent.auxiliary_client.call_llm",
+                 side_effect=AssertionError("--keep-body must not call the LLM"))
+
+
+def _loop_into_triage(conn, tid):
+    """Two same-cause blocks (with an unblock between) route the card to triage."""
+    for _ in range(2):
+        with kb.write_txn(conn):
+            conn.execute("UPDATE tasks SET status='ready' WHERE id=?", (tid,))
+        assert kb.claim_task(conn, tid, claimer="w") is not None
+        kb.block_task(conn, tid, reason="worker preflight: stale", kind="needs_input")
+        if kb.get_task(conn, tid).status == "blocked":
+            kb.unblock_task(conn, tid)
+    assert kb.get_task(conn, tid).status == "triage"
+
+
+def test_cli_specify_keep_body_promotes_without_llm(kanban_home, capsys):
+    with kbc.connect() as conn:
+        tid = kb.create_task(conn, title="Origineel", body="Spec blijft", triage=True)
+    with _no_llm():
+        rc = _run_cli("specify", tid, "--keep-body", "--json", "--author", "manager")
+    assert rc == 0
+    row = jsonlib.loads(capsys.readouterr().out.strip().splitlines()[-1])
+    assert row["ok"] is True and row["task_id"] == tid
+    with kbc.connect() as conn:
+        task = kb.get_task(conn, tid)
+        assert task.status in {"todo", "ready"}
+        assert (task.title, task.body) == ("Origineel", "Spec blijft")
+        specified = [e for e in kb.list_events(conn, tid) if e.kind == "specified"]
+        assert specified[-1].payload == {"keep_body": True}
+        assert any("body kept" in c.body for c in kb.list_comments(conn, tid))
+
+
+def test_cli_specify_keep_body_resets_block_loop(kanban_home):
+    with kbc.connect() as conn:
+        tid = kb.create_task(conn, title="t", assignee="w")
+        _loop_into_triage(conn, tid)
+        assert kb.get_task(conn, tid).block_recurrences == 2
+    with _no_llm():
+        assert _run_cli("specify", tid, "--keep-body") == 0
+    with kbc.connect() as conn:
+        assert kb.get_task(conn, tid).block_recurrences == 0
+        with kb.write_txn(conn):
+            conn.execute("UPDATE tasks SET status='ready' WHERE id=?", (tid,))
+        assert kb.claim_task(conn, tid, claimer="w") is not None
+        kb.block_task(conn, tid, reason="worker preflight: stale", kind="needs_input")
+        # One fresh block is allowed before the breaker routes it to triage again.
+        assert kb.get_task(conn, tid).status == "blocked"
+
+
+def test_specify_without_keep_body_keeps_upstream_counter(kanban_home):
+    with kbc.connect() as conn:
+        tid = kb.create_task(conn, title="t", assignee="w")
+        _loop_into_triage(conn, tid)
+        assert kb.specify_triage_task(conn, tid)
+        assert kb.get_task(conn, tid).block_recurrences == 2
+
+
+def test_cli_specify_keep_body_refuses_non_triage(kanban_home, capsys):
+    with kbc.connect() as conn:
+        tid = kb.create_task(conn, title="t")
+    with _no_llm():
+        assert _run_cli("specify", tid, "--keep-body") == 1
+    assert "not in triage" in capsys.readouterr().err
+
+
+def test_decompose_has_no_keep_body_flag(kanban_home):
+    with pytest.raises(SystemExit):
+        _run_cli("decompose", "t_x", "--keep-body")

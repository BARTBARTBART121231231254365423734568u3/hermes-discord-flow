+    purpose, so its next block must not route it straight back to triage.
     """
     if title is not None and not title.strip():
         raise ValueError("title cannot be blank")
@@ -3943,6 +3948,8 @@ def specify_triage_task(
         if existing is None:
             return False
         sets: list[str] = ["status = 'todo'"]
+        if reset_block_loop:
+            sets.append("block_recurrences = 0")
         params: list[Any] = []
         changed_fields: list[str] = []
         if title is not None and title.strip() != (existing["title"] or ""):
@@ -3971,10 +3978,16 @@ def specify_triage_task(
                 "Specified — updated " + ", ".join(changed_fields) + " and promoted to todo.",
                 int(time.time()),
             )
-        _append_event(
-            conn, task_id, "specified",
-            {"changed_fields": changed_fields} if changed_fields else None,
-        )
+        elif reset_block_loop and author and author.strip():
+            _insert_comment(
+                conn, task_id, author.strip(),
+                "Specified — body kept, promoted to todo (block-loop counter reset).",
+                int(time.time()),
+            )
+        payload: dict[str, Any] = {"changed_fields": changed_fields} if changed_fields else {}
+        if reset_block_loop:
+            payload["keep_body"] = True
+        _append_event(conn, task_id, "specified", payload or None)
     # Own IMMEDIATE txn (outside the one above): a parent-free specified task
     # flips to 'ready' now instead of idling until the next tick.
     recompute_ready(conn)

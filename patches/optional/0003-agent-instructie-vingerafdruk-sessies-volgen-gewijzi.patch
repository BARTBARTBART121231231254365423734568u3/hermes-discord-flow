new file mode 100644
index 0000000000..cf2ca4f789
--- /dev/null
+++ b/tests/agent/test_instruction_fingerprint.py
@@ -0,0 +1,131 @@
+"""Instruction fingerprint: a changed SOUL.md / extra instruction file / config.yaml reaches existing sessions on their next turn."""
+from __future__ import annotations
+
+import os
+import time
+from unittest.mock import MagicMock
+
+import pytest
+
+from agent import instruction_fingerprint as fpmod
+from agent.conversation_loop import _restore_or_build_system_prompt
+
+
+@pytest.fixture()
+def home(tmp_path, monkeypatch):
+    root = tmp_path / "hermes"
+    (root / "team").mkdir(parents=True)
+    (root / "SOUL.md").write_text("# Manager\nRegel A.\n")
+    (root / "team" / "TEAM.md").write_text("# Teamafspraken\n")
+    (root / "config.yaml").write_text("model: {}\n")
+    monkeypatch.setattr(fpmod, "enabled", lambda: True)
+    monkeypatch.setattr(fpmod, "instruction_files",
+                        lambda: (root / "SOUL.md", root / "team" / "TEAM.md", root / "config.yaml"))
+    fpmod._cache.clear()
+    return root
+
+
+def _touch(path, text):
+    path.write_text(text)
+    later = time.time() + 5  # a different mtime even on coarse filesystems
+    os.utime(path, (later, later))
+
+
+def test_stamp_is_current_until_an_instruction_file_changes(home):
+    prompt = fpmod.stamp("BODY")
+    assert prompt.startswith("BODY\n\n[Instructieversie ")
+    assert fpmod.is_current(prompt)
+    for name, text in (("SOUL.md", "# Manager\nRegel B.\n"), ("team/TEAM.md", "# Nieuw\n"), ("config.yaml", "x: 1\n")):
+        _touch(home / name, text)
+        assert not fpmod.is_current(prompt), name
+        prompt = fpmod.stamp("BODY")
+        assert fpmod.is_current(prompt), name
+
+
+def test_unchanged_content_keeps_the_fingerprint(home):
+    before = fpmod.current_fingerprint()
+    _touch(home / "SOUL.md", (home / "SOUL.md").read_text())  # same bytes, new mtime
+    assert fpmod.current_fingerprint() == before
+
+
+def test_legacy_prompt_without_stamp_is_stale_when_a_soul_exists(home):
+    assert not fpmod.is_current("OLD PROMPT")
+    (home / "SOUL.md").unlink()
+    assert fpmod.is_current("OLD PROMPT")
+
+
+def _agent(stored):
+    db = MagicMock()
+    db.get_session.return_value = {"system_prompt": stored}
+    agent = MagicMock()
+    agent._cached_system_prompt = None
+    agent.session_id = "s1"
+    agent.model = "test-model"
+    agent.provider = "openrouter"
+    agent.platform = "discord"
+    agent._session_db = db
+    agent._use_prompt_caching = False
+    agent._persist_disabled = False
+    agent._platform_hint_overrides = None
+    agent._surface_switch_note = ""
+    agent._gateway_turn_context_notes = ""
+    agent._build_system_prompt = MagicMock(side_effect=lambda _m=None: fpmod.stamp("NEW BODY"))
+    return agent
+
+
+def test_restore_reuses_a_current_snapshot(home):
+    stored = fpmod.stamp("STORED BODY")
+    agent = _agent(stored)
+    _restore_or_build_system_prompt(agent, None, [{"role": "user", "content": "hi"}])
+    assert agent._cached_system_prompt == stored
+    agent._build_system_prompt.assert_not_called()
+
+
+def test_restore_rebuilds_after_a_soul_change_and_keeps_the_conversation(home):
+    stored = fpmod.stamp("STORED BODY")
+    _touch(home / "SOUL.md", "# Manager\nNieuwe regel.\n")
+    agent = _agent(stored)
+    history = [{"role": "user", "content": "hi"}, {"role": "assistant", "content": "hallo"}]
+    _restore_or_build_system_prompt(agent, None, history)
+    agent._build_system_prompt.assert_called_once()
+    assert agent._cached_system_prompt.startswith("NEW BODY")
+    assert fpmod.is_current(agent._cached_system_prompt)
+    agent._session_db.update_system_prompt.assert_called_once_with("s1", agent._cached_system_prompt)
+    assert history[1]["content"] == "hallo"  # history is untouched
+
+
+def test_restore_rebuilds_a_legacy_snapshot(home):
+    agent = _agent("OLD PROMPT WITHOUT STAMP")
+    _restore_or_build_system_prompt(agent, None, [{"role": "user", "content": "hi"}])
+    agent._build_system_prompt.assert_called_once()
+
+
+def test_cached_prompt_check_only_compares_stamped_prompts(home):
+    prompt = fpmod.stamp("BODY")
+    assert not fpmod.cached_is_stale(prompt)
+    assert not fpmod.cached_is_stale("LEGACY WITHOUT STAMP")
+    _touch(home / "SOUL.md", "# Manager\nAnders.\n")
+    assert fpmod.cached_is_stale(prompt)
+
+
+def test_disabled_is_upstream_behaviour(home, monkeypatch):
+    monkeypatch.setattr(fpmod, "enabled", lambda: False)
+    assert fpmod.stamp("BODY") == "BODY"
+    assert fpmod.is_current("OLD PROMPT")
+    assert not fpmod.cached_is_stale("BODY [Instructieversie 000000000000]")
+
+
+def test_extra_instruction_files_come_from_config(tmp_path, monkeypatch):
+    root = tmp_path / "hermes"
+    (root / "team").mkdir(parents=True)
+    monkeypatch.setenv("HERMES_HOME", str(root))
+    monkeypatch.setattr(fpmod, "_agent_config", lambda: {
+        "instruction_fingerprint": True, "instruction_fingerprint_files": ["team/TEAM.md"]})
+    files = fpmod.instruction_files()
+    assert [p.name for p in files] == ["SOUL.md", "TEAM.md", "config.yaml"]
+    assert files[1].resolve() == (root / "team" / "TEAM.md").resolve()
+    assert "Heb je TEAM.md eerder in dit gesprek gelezen" in fpmod.stamp("BODY")
+
+    monkeypatch.setattr(fpmod, "_agent_config", lambda: {"instruction_fingerprint": True})
+    assert [p.name for p in fpmod.instruction_files()] == ["SOUL.md", "config.yaml"]
+    assert "Heb je" not in fpmod.stamp("BODY")

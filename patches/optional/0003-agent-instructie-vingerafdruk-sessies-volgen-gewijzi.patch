+++ b/agent/instruction_fingerprint.py
@@ -0,0 +1,141 @@
+"""Instruction fingerprint — a session follows changed instructions on its next turn.
+
+A session's system prompt is built once and reused on every later turn (prefix cache), from memory while
+the agent is cached and from the stored snapshot after that. Without this a changed SOUL.md, profile
+config.yaml or shared instruction file only reached NEW sessions; long-lived chat threads and desktop
+sessions kept the rules they started with.
+
+Every built prompt ends with a stamp ``[Instructieversie <fp>]``, where ``<fp>`` hashes the current
+contents of ``<home>/SOUL.md``, the extra files of ``agent.instruction_fingerprint_files`` (paths
+relative to the Hermes root, e.g. a shared ``team/TEAM.md``) and ``<home>/config.yaml``. A prompt whose stamp
+differs from the current fingerprint (or that has no stamp: built before this patch, when a SOUL.md
+exists) is stale: the stored snapshot is not reused and a cached prompt is dropped before the next turn, so that turn rebuilds and
+persists the prompt once (one prefix-cache miss per instruction change). Unchanged files keep the
+fingerprint, so caching is unaffected. File reads are memoised on (mtime_ns, size).
+
+Opt-in: only active with ``agent.instruction_fingerprint: true`` in the agent's config.yaml, so upstream
+behaviour (and its tests) is unchanged when the key is absent.
+
+    agent:
+      instruction_fingerprint: true
+      instruction_fingerprint_files: [team/TEAM.md]   # optional
+"""
+from __future__ import annotations
+
+import hashlib
+import logging
+import re
+from pathlib import Path
+from typing import Any, Dict, Optional, Tuple
+
+logger = logging.getLogger(__name__)
+
+STAMP_PREFIX = "[Instructieversie "
+_STAMP_RE = re.compile(r"\[Instructieversie ([0-9a-f]{12})\]")
+_STAMP_NOTE = "Deze instructies gelden boven regels die eerder in dit gesprek staan."
+_STAMP_REREAD = " Heb je {names} eerder in dit gesprek gelezen, lees die dan opnieuw voordat je ze gebruikt."
+_cache: Dict[str, Tuple[Tuple[int, int], str]] = {}
+
+
+def _digest(path: Path) -> str:
+    try:
+        st = path.stat()
+    except OSError:
+        return "-"
+    key = (st.st_mtime_ns, st.st_size)
+    hit = _cache.get(str(path))
+    if hit and hit[0] == key:
+        return hit[1]
+    try:
+        value = hashlib.sha256(path.read_bytes()).hexdigest()
+    except OSError:
+        return "-"
+    _cache[str(path)] = (key, value)
+    return value
+
+
+def _agent_config() -> Dict[str, Any]:
+    from hermes_cli.config import load_config_readonly
+    agent = (load_config_readonly() or {}).get("agent")
+    return agent if isinstance(agent, dict) else {}
+
+
+def enabled() -> bool:
+    try:
+        return bool(_agent_config().get("instruction_fingerprint"))
+    except Exception:
+        return False
+
+
+def _extra_files() -> Tuple[Path, ...]:
+    """``agent.instruction_fingerprint_files``: extra instruction files (relative to the Hermes root)."""
+    from hermes_constants import get_default_hermes_root
+    try:
+        configured = _agent_config().get("instruction_fingerprint_files") or []
+    except Exception:
+        return ()
+    if isinstance(configured, str):
+        configured = [configured]
+    root = get_default_hermes_root()
+    return tuple(root / Path(str(p)).expanduser() for p in configured if str(p or "").strip())
+
+
+def instruction_files() -> Tuple[Path, ...]:
+    """SOUL.md first (its absence matters for legacy prompts), config.yaml last."""
+    from hermes_constants import get_hermes_home
+    home = get_hermes_home()
+    return (home / "SOUL.md", *_extra_files(), home / "config.yaml")
+
+
+def _stamp_note() -> str:
+    extra = instruction_files()[1:-1]
+    if not extra:
+        return _STAMP_NOTE
+    return _STAMP_NOTE + _STAMP_REREAD.format(names=", ".join(p.name for p in extra))
+
+
+def current_fingerprint() -> str:
+    joined = "|".join(_digest(p) for p in instruction_files())
+    return hashlib.sha256(joined.encode()).hexdigest()[:12]
+
+
+def stamp(prompt: str) -> str:
+    """Append the stamp to a freshly built prompt (at the very end: the cached prefix stays intact)."""
+    if not enabled():
+        return prompt
+    try:
+        fp = current_fingerprint()
+    except Exception:  # never break prompt building
+        logger.debug("instruction fingerprint unavailable", exc_info=True)
+        return prompt
+    return f"{prompt}\n\n{STAMP_PREFIX}{fp}] {_stamp_note()}"
+
+
+def stamped_fingerprint(prompt: Optional[str]) -> Optional[str]:
+    found = _STAMP_RE.findall(prompt or "")
+    return found[-1] if found else None
+
+
+def cached_is_stale(prompt: Optional[str]) -> bool:
+    """For an in-memory prompt: True only when it carries a stamp that differs from the current one."""
+    if not enabled():
+        return False
+    try:
+        found = stamped_fingerprint(prompt)
+        return bool(found) and found != current_fingerprint()
+    except Exception:
+        return False
+
+
+def is_current(prompt: Optional[str]) -> bool:
+    """False when the prompt was built from other instructions than the current ones (fail-open)."""
+    if not enabled():
+        return True
+    try:
+        found = stamped_fingerprint(prompt)
+        if found is None:  # snapshot from before this patch: stale whenever a real SOUL.md exists
+            return not instruction_files()[0].exists()
+        return found == current_fingerprint()
+    except Exception:
+        logger.debug("instruction fingerprint check failed; keeping prompt", exc_info=True)
+        return True

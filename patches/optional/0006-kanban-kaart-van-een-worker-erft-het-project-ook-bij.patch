+"""A worker's ``kanban_create`` inherits the project of its own card.
+
+A worker created a follow-up card with ``workspace_kind="worktree"`` but no
+``project``. Upstream only inherited the project when all workspace fields were
+omitted, so the card got a worktree without a path or repository anchor and
+failed when its worker started. "worktree" without a path is exactly what a project
+worktree provides, so it inherits too; a worktree card that still has no project,
+path, board project or board default_workdir is refused up front.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+from pathlib import Path
+
+import pytest
+
+
+@pytest.fixture
+def project_worker(monkeypatch, tmp_path):
+    """A dispatcher worker whose own card is linked to a project."""
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setenv("HERMES_PROFILE", "designer")
+    monkeypatch.delenv("HERMES_SESSION_ID", raising=False)
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+
+    from hermes_cli import kanban_db as kb
+    from hermes_cli import kanban_db_connect as kbc
+    from hermes_cli import projects_db as pdb
+
+    repo = tmp_path / "repo"
+    repo.mkdir()
+    with pdb.connect_closing() as pconn:
+        pid = pdb.create_project(pconn, name="Demo App", primary_path=str(repo))
+        project = pdb.get_project(pconn, pid)
+    kb._INITIALIZED_PATHS.clear()
+    kb.init_db()
+    conn = kbc.connect()
+    try:
+        tid = kb.create_task(conn, title="ontwerp", assignee="designer", project_id=pid)
+        kb.claim_task(conn, tid)
+        run_id = kb._current_run_id(conn, tid)
+    finally:
+        conn.close()
+    monkeypatch.setenv("HERMES_KANBAN_TASK", tid)
+    monkeypatch.setenv("HERMES_KANBAN_RUN_ID", str(run_id))
+    return tid, project, repo
+
+
+def _create(**args):
+    from tools import kanban_tools as kt
+    return json.loads(kt._handle_create({"title": "vervolg", "assignee": "coder", **args}))
+
+
+def _task(tid):
+    from hermes_cli import kanban_db as kb
+    from hermes_cli import kanban_db_connect as kbc
+    with kbc.connect_closing() as conn:
+        return kb.get_task(conn, tid)
+
+
+def test_explicit_worktree_inherits_the_worker_project(project_worker):
+    tid, project, repo = project_worker
+    out = _create(parents=[tid], workspace_kind="worktree")
+    assert out["ok"] is True, out
+    assert (out["project_id"], out["workspace_kind"]) == (project.id, "worktree")
+    child = _task(out["task_id"])
+    assert child.workspace_path == os.path.join(str(repo), ".worktrees", child.id)
+    assert child.branch_name.startswith(f"{project.slug}/{child.id}")
+
+
+def test_omitted_workspace_still_inherits(project_worker):
+    tid, project, _ = project_worker
+    out = _create()
+    assert (out["project_id"], out["workspace_kind"]) == (project.id, "worktree")
+
+
+@pytest.mark.parametrize("explicit", [{"workspace_kind": "scratch"}, {"project": ""}])
+def test_explicit_opt_out_stays_without_project(project_worker, explicit):
+    out = _create(**explicit)
+    assert out["ok"] is True, out
+    assert (out["workspace_kind"], out["project_id"]) == ("scratch", None)
+
+
+def test_worktree_without_any_project_is_refused(project_worker, monkeypatch):
+    """No inheritable project (not a dispatcher worker) and no path: refuse up front."""
+    monkeypatch.delenv("HERMES_KANBAN_TASK")
+    monkeypatch.delenv("HERMES_KANBAN_RUN_ID")
+    out = _create(workspace_kind="worktree")
+    assert "error" in out
+    assert "project" in out["error"]
+
+
+def test_worktree_with_a_board_default_workdir_is_allowed(project_worker, monkeypatch, tmp_path):
+    """The board's ``default_workdir`` is a valid worktree anchor (upstream behaviour)."""
+    from hermes_cli import kanban_db as kb
+    monkeypatch.delenv("HERMES_KANBAN_TASK")
+    monkeypatch.delenv("HERMES_KANBAN_RUN_ID")
+    monkeypatch.setattr(kb, "_board_meta_for", lambda _board: {"default_workdir": str(tmp_path / "repo")})
+    out = _create(workspace_kind="worktree")
+    assert out.get("ok") is True, out

             guild_id = getattr(guild, "id", None)
         return str(guild_id) if guild_id else None
 
+    # --- Owner questions with answer buttons (forum posts) ---
+    #
+    # An external poster creates a forum post per open question with buttons whose custom_id is
+    # ``tq:<task_id>:<episode>:<n>`` (option n) or ``tq:<task_id>:<episode>:x`` ("Anders…": free
+    # text). ``<episode>`` is the id of the kanban ``blocked`` event that asked the question. Only
+    # the configured owner (``decision_owner_id``) may answer; the answer reaches the agent of that
+    # post as a normal message, e.g. "Antwoord van de eigenaar (knop): optie 2 — Variant B".
+    #
+    # Config (platforms.discord, stored in ``extra``):
+    #   decision_owner_id      Discord user id(s) allowed to answer (comma separated)
+    #   question_owner_label   name used in the texts (default "de eigenaar")
+    #   question_tags          {open, beantwoord, verwerkt}: forum tag names (defaults as shown)
+    #   question_board         kanban board checked for "still open" (default: current board)
+    #   question_texts         overrides for the user-facing texts below (same keys)
+
+    _QUESTION_TEXT_DEFAULTS: Dict[str, str] = {
+        "not_owner": "Alleen {label} kan deze vraag beantwoorden.",
+        "answer_button": "Antwoord van {label} (knop): optie {choice} — {option}",
+        "answer_other": "Antwoord van {label} (anders): {text}",
+        "already_answered": ("Deze vraag is al beantwoord of vervangen door een nieuwere vraag (zie de post). "
+                             "Wil je iets wijzigen, typ het dan in de post."),
+        "already_answered_modal": ("Deze vraag is intussen al beantwoord of vervangen. Je tekst is niet verstuurd; "
+                                   "wil je iets wijzigen, typ het dan in de post."),
+        "received": "✅ Ontvangen",
+        "failed": "⚠️ Lukt niet, typ je antwoord in de post.",
+        "empty": "Leeg antwoord; typ je antwoord in de post.",
+        "chosen": "✅ **Gekozen:** {option}",
+        "other_option": "Anders: {text}",
+        "modal_title": "Ander antwoord",
+        "modal_label": "Jouw antwoord of tegenvraag",
+    }
+    _QUESTION_TAG_DEFAULTS: Dict[str, str] = {"open": "open", "beantwoord": "beantwoord", "verwerkt": "verwerkt"}
+    _QUESTION_MESSAGE_BUDGET = 1900  # edited question message stays well below Discord's 2000 chars
+
+    def _question_text(self, key: str, **values: Any) -> str:
+        """User-facing question text: ``question_texts[key]`` from the config, else the default.
+        A broken override (unknown placeholder) falls back to the default."""
+        values.setdefault("label", self._question_owner_label())
+        overrides = self.config.extra.get("question_texts")
+        template = overrides.get(key) if isinstance(overrides, dict) else None
+        default = self._QUESTION_TEXT_DEFAULTS[key]
+        try:
+            return str(template if template else default).format(**values)
+        except (KeyError, IndexError, ValueError):
+            return default.format(**values)
+
+    def _question_owner_label(self) -> str:
+        return str(self.config.extra.get("question_owner_label") or "").strip() or "de eigenaar"
+
+    def _question_tag_names(self) -> Dict[str, str]:
+        configured = self.config.extra.get("question_tags")
+        names = dict(self._QUESTION_TAG_DEFAULTS)
+        if isinstance(configured, dict):
+            names.update({k: str(v).strip() for k, v in configured.items() if k in names and str(v or "").strip()})
+        return names
+
+    async def _dispatch_question_interaction(self, interaction: discord.Interaction) -> bool:
+        """Route owner-question components by custom_id; False when the interaction is not ours."""
+        data = getattr(interaction, "data", None) or {}
+        cid = str(data.get("custom_id", "") if isinstance(data, dict) else "")
+        if cid.startswith("tq:"):
+            await self._handle_question_button(interaction)
+            return True
+        if cid.startswith("tqm:"):
+            await self._handle_question_modal(interaction)
+            return True
+        return False
+
+    async def _handle_question_button(self, interaction: discord.Interaction) -> None:
+        """``tq:<task>:<episode>:<n>`` answers with option n; ``tq:<task>:<episode>:x`` ("Anders…")
+        opens a text field with custom_id ``tqm:<task>:<episode>`` whose submit is handled by id
+        (no in-memory state, so a field that was open during a gateway restart still works)."""
+        custom_id = str((interaction.data or {}).get("custom_id", ""))
+        parts = custom_id.split(":")
+        if len(parts) != 4 or not self._is_question_owner(interaction):
+            await interaction.response.send_message(self._question_text("not_owner"), ephemeral=True)
+            return
+        choice = parts[3]
+        if not self._question_still_open(parts[1], parts[2]):
+            await interaction.response.send_message(self._question_text("already_answered"), ephemeral=True)
+            return
+        if choice == "x":
+            modal = discord.ui.Modal(title=self._question_text("modal_title")[:45],
+                                     custom_id=f"tqm:{parts[1]}:{parts[2]}"[:100], timeout=None)
+            modal.add_item(discord.ui.TextInput(label=self._question_text("modal_label")[:45], custom_id="answer",
+                                                style=discord.TextStyle.paragraph, max_length=1500))
+            await interaction.response.send_modal(modal)
+            return
+        option = choice
+        for row in getattr(interaction.message, "components", None) or []:
+            for comp in getattr(row, "children", None) or []:
+                if getattr(comp, "custom_id", None) == custom_id:
+                    option = getattr(comp, "label", None) or choice
+        await self._finish_question(interaction, custom_id, option,
+                                    self._question_text("answer_button", choice=choice, option=option))
+
+    async def _handle_question_modal(self, interaction: discord.Interaction) -> None:
+        """Submitted "Anders…" field (``tqm:<task>:<episode>``): read the text from the payload itself."""
+        custom_id = str((interaction.data or {}).get("custom_id", ""))
+        if not self._is_question_owner(interaction):
+            await interaction.response.send_message(self._question_text("not_owner"), ephemeral=True)
+            return
+        text = ""
+        for row in (interaction.data or {}).get("components", []) or []:
+            for comp in row.get("components", []) or []:
+                if comp.get("custom_id") == "answer":
+                    text = str(comp.get("value") or "").strip()
+        if not text:
+            await interaction.response.send_message(self._question_text("empty"), ephemeral=True)
+            return
+        parts = custom_id.split(":")
+        if len(parts) == 3 and not self._question_still_open(parts[1], parts[2]):
+            await interaction.response.send_message(self._question_text("already_answered_modal"), ephemeral=True)
+            return
+        await self._finish_question(interaction, custom_id, self._question_text("other_option", text=text[:150]),
+                                    self._question_text("answer_other", text=text))
+
+    def _question_still_open(self, task_id: str, episode: str) -> bool:
+        """True while the card is still blocked on exactly this question (its latest real ``blocked``
+        event is the question's episode). A question answered elsewhere (typed in the post, another
+        client, the CLI, a wait-state update "Wacht op …") is closed, so a late click never adds a
+        second, conflicting answer. Unreadable board -> allow (fail open to the owner)."""
+        import sqlite3
+        try:
+            from hermes_cli import kanban_db as _kb
+            board = str(self.config.extra.get("question_board") or "").strip() or None
+            conn = sqlite3.connect(f"file:{_kb.kanban_db_path(board=board)}?mode=ro", uri=True, timeout=5)
+            try:
+                row = conn.execute("SELECT status FROM tasks WHERE id = ?", (task_id,)).fetchone()
+                if not row or row[0] != "blocked":
+                    return False
+                last = conn.execute("SELECT id, payload FROM task_events WHERE task_id = ? AND kind = 'blocked' "
+                                    "ORDER BY id DESC LIMIT 1", (task_id,)).fetchone()
+            finally:
+                conn.close()
+            if not last:
+                return False
+            try:
+                payload = json.loads(last[1]) if last[1] else {}
+            except (TypeError, ValueError):
+                payload = {}
+            if isinstance(payload, dict) and payload.get("status_update"):
+                return False  # answered and rewritten to a wait state ("Wacht op …")
+            return str(last[0]) == str(episode)
+        except Exception:
+            logger.warning("[Discord] question %s: board unreadable, accepting the answer", task_id, exc_info=True)
+            return True
+
+    def _is_question_owner(self, interaction: discord.Interaction) -> bool:
+        owners = {o.strip() for o in str(self.config.extra.get("decision_owner_id", "") or "").split(",") if o.strip()}
+        return bool(owners) and str(getattr(getattr(interaction, "user", None), "id", "")) in owners
+
+    async def _finish_question(self, interaction: discord.Interaction, custom_id: str, option: str, text: str) -> None:
+        """Acknowledge at once (defer, well within Discord's 3 s), then pass the answer to the agent and
+        confirm with "✅ Ontvangen"; only then remove the buttons and tag the post as answered. If passing
+        the answer fails, the owner is told to type it in the post."""
+        try:
+            await interaction.response.defer()
+        except Exception as e:
+            if not self._is_discord_unknown_interaction(e):
+                logger.warning("[Discord] question %s: defer failed", custom_id, exc_info=True)
+        try:
+            await self.handle_message(self._build_slash_event(interaction, text))
+        except Exception:
+            logger.error("[Discord] question %s: answer could not be passed on", custom_id, exc_info=True)
+            with suppress(Exception):
+                await interaction.followup.send(self._question_text("failed"), ephemeral=True)
+            return
+        with suppress(Exception):
+            await interaction.followup.send(self._question_text("received"), ephemeral=True)
+        message = getattr(interaction, "message", None)
+        if message is not None:
+            suffix = ("\n\n" + self._question_text("chosen", option=option[:150]))[: self._QUESTION_MESSAGE_BUDGET]
+            content = (getattr(message, "content", "") or "")[: self._QUESTION_MESSAGE_BUDGET - len(suffix)] + suffix
+            try:
+                await message.edit(content=content, view=None)
+            except Exception:
+                logger.warning("[Discord] question %s: could not update the question message", custom_id, exc_info=True)
+        thread = interaction.channel
+        forum = getattr(thread, "parent", None)
+        tags = getattr(forum, "available_tags", None) or []
+        names = self._question_tag_names()
+        answered = next((t for t in tags if t.name.lower() == names["beantwoord"].lower()), None)
+        if answered is not None and isinstance(thread, discord.Thread):
+            managed = {n.lower() for n in names.values()}
+            keep = [t for t in (thread.applied_tags or []) if t.name.lower() not in managed]
+            try:
+                await thread.edit(applied_tags=(keep + [answered])[:5])
+            except Exception:
+                logger.warning("[Discord] question %s: could not set tag '%s'", custom_id, names["beantwoord"],
+                               exc_info=True)
+
     def _build_slash_event(self, interaction: discord.Interaction, text: str) -> MessageEvent:
         """Build a MessageEvent from a Discord slash command interaction."""
         is_dm = isinstance(interaction.channel, discord.DMChannel)

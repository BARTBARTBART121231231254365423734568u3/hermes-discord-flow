+@pytest.mark.parametrize("content_len,option_len", [(0, 10), (1999, 10), (5000, 300), (1890, 150)])
+def test_edited_message_stays_below_2000_chars(monkeypatch, content_len, option_len):
+    adapter = _adapter()
+    monkeypatch.setattr(adapter, "_question_still_open", lambda *_: True)
+    interaction = _interaction(f"tq:{TASK}:{EPISODE}:1", content="v" * content_len,
+                               options=((1, "o" * option_len), (2, "B")))

@@ -0,0 +1,392 @@
+"""Owner-question buttons in a Discord forum post (custom_id ``tq:<task>:<episode>:<n|x>``).
+
+The buttons are posted over REST by an external question poster, so the adapter handles
+them (and the "Anders…" text field ``tqm:<task>:<episode>``) by custom_id in
+``on_interaction``. These tests drive the handlers with fake interaction, message and
+thread objects: no network, no Discord client. They are plain sync tests that run the
+coroutines with ``asyncio.run`` so they need no async pytest plugin.
+"""
+
+from __future__ import annotations
+
+import asyncio
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+import pytest
+
+from gateway.config import PlatformConfig
+import plugins.platforms.discord.adapter as adapter_mod
+from plugins.platforms.discord.adapter import DiscordAdapter
+
+OWNER_ID = "1001"
+OTHER_ID = "2002"
+TASK = "t_0000abcd"
+EPISODE = "12"
+
+
+class FakeTag:
+    def __init__(self, name: str) -> None:
+        self.name = name
+
+    def __repr__(self) -> str:  # readable assertion output
+        return f"FakeTag({self.name!r})"
+
+
+class FakeThread:
+    """Stands in for ``discord.Thread`` (patched onto the adapter's ``discord`` module)."""
+
+    def __init__(self, tags, applied) -> None:
+        self.id = 555
+        self.name = "Vraag: A of B?"
+        self.guild = None
+        self.parent = SimpleNamespace(id=444, name="vragen", available_tags=tags, topic=None)
+        self.parent_id = 444
+        self.applied_tags = applied
+        self.edit = AsyncMock()
+
+
+class FakeModal:
+    def __init__(self, *, title=None, custom_id=None, timeout=None, **_):
+        self.title, self.custom_id, self.timeout, self.children = title, custom_id, timeout, []
+
+    def add_item(self, item):
+        self.children.append(item)
+
+
+class FakeTextInput:
+    def __init__(self, *, label=None, custom_id=None, style=None, max_length=None, **_):
+        self.label, self.custom_id, self.style, self.max_length = label, custom_id, style, max_length
+
+
+@pytest.fixture(autouse=True)
+def fake_discord_types(monkeypatch):
+    monkeypatch.setattr(adapter_mod.discord, "Thread", FakeThread)
+    if not hasattr(adapter_mod.discord.ui, "Modal"):  # mocked discord module (library not installed)
+        monkeypatch.setattr(adapter_mod.discord.ui, "Modal", FakeModal, raising=False)
+        monkeypatch.setattr(adapter_mod.discord.ui, "TextInput", FakeTextInput, raising=False)
+
+
+def _adapter(**extra) -> DiscordAdapter:
+    adapter = DiscordAdapter(PlatformConfig(enabled=True, token="***", extra={"decision_owner_id": OWNER_ID, **extra}))
+    adapter.handle_message = AsyncMock()
+    return adapter
+
+
+def _components(task, episode, *options):
+    children = [SimpleNamespace(custom_id=f"tq:{task}:{episode}:{n}", label=label) for n, label in options]
+    children.append(SimpleNamespace(custom_id=f"tq:{task}:{episode}:x", label="✏️ Anders…"))
+    return [SimpleNamespace(children=children)]
+
+
+def _interaction(custom_id: str, *, user_id: str = OWNER_ID, content: str = "**Vraag:** A of B?",
+                 options=((1, "Variant A"), (2, "Variant B")), data_extra=None, tags=None, applied=None):
+    tags = tags if tags is not None else [FakeTag("open"), FakeTag("beantwoord"), FakeTag("verwerkt"), FakeTag("bug")]
+    applied = applied if applied is not None else [tags[0], tags[3]]
+    thread = FakeThread(tags, applied)
+    parts = custom_id.split(":")
+    task, episode = (parts[1], parts[2]) if len(parts) >= 3 else (TASK, EPISODE)
+    message = SimpleNamespace(content=content, components=_components(task, episode, *options), edit=AsyncMock())
+    return SimpleNamespace(
+        data={"custom_id": custom_id, **(data_extra or {})},
+        user=SimpleNamespace(id=int(user_id), display_name="someone"),
+        response=SimpleNamespace(defer=AsyncMock(), send_message=AsyncMock(), send_modal=AsyncMock()),
+        followup=SimpleNamespace(send=AsyncMock()),
+        message=message, channel=thread, channel_id=thread.id, guild_id=None,
+    )
+
+
+def _modal_submit(text: str, *, user_id: str = OWNER_ID, episode: str = EPISODE):
+    return _interaction(f"tqm:{TASK}:{episode}", user_id=user_id, data_extra={"components": [
+        {"type": 1, "components": [{"type": 4, "custom_id": "answer", "value": text}]}]})
+
+
+def _run(adapter, interaction) -> bool:
+    return asyncio.run(adapter._dispatch_question_interaction(interaction))
+
+
+def _sent_text(adapter) -> str:
+    adapter.handle_message.assert_awaited_once()
+    return adapter.handle_message.await_args.args[0].text
+
+
+def _ephemeral(interaction) -> str:
+    interaction.response.send_message.assert_awaited_once()
+    assert interaction.response.send_message.await_args.kwargs.get("ephemeral") is True
+    return interaction.response.send_message.await_args.args[0]
+
+
+# (a) owner clicks an option -------------------------------------------------------------------
+
+def test_owner_click_is_acknowledged_passed_on_and_tagged(monkeypatch):
+    adapter = _adapter()
+    monkeypatch.setattr(adapter, "_question_still_open", lambda task, ep: (task, ep) == (TASK, EPISODE))
+    interaction = _interaction(f"tq:{TASK}:{EPISODE}:2")
+
+    assert _run(adapter, interaction) is True
+
+    interaction.response.defer.assert_awaited_once()
+    event = adapter.handle_message.await_args.args[0]
+    assert _sent_text(adapter) == "Antwoord van de eigenaar (knop): optie 2 — Variant B"
+    assert event.source.thread_id == str(interaction.channel.id)
+    interaction.followup.send.assert_awaited_once_with("✅ Ontvangen", ephemeral=True)
+    edit = interaction.message.edit.await_args.kwargs
+    assert edit["view"] is None
+    assert edit["content"] == "**Vraag:** A of B?\n\n✅ **Gekozen:** Variant B"
+    applied = interaction.channel.edit.await_args.kwargs["applied_tags"]
+    assert [t.name for t in applied] == ["bug", "beantwoord"]
+    interaction.response.send_message.assert_not_awaited()
+
+
+def test_failed_hand_off_tells_the_owner_and_keeps_the_buttons(monkeypatch):
+    adapter = _adapter()
+    adapter.handle_message = AsyncMock(side_effect=RuntimeError("boom"))
+    monkeypatch.setattr(adapter, "_question_still_open", lambda *_: True)
+    interaction = _interaction(f"tq:{TASK}:{EPISODE}:1")
+
+    _run(adapter, interaction)
+
+    interaction.followup.send.assert_awaited_once_with("⚠️ Lukt niet, typ je antwoord in de post.", ephemeral=True)
+    interaction.message.edit.assert_not_awaited()
+    interaction.channel.edit.assert_not_awaited()
+
+
+# (b) someone else clicks ---------------------------------------------------------------------
+
+@pytest.mark.parametrize("extra", [{}, {"decision_owner_id": ""}])
+def test_click_by_someone_else_is_refused(monkeypatch, extra):
+    adapter = _adapter(**extra)
+    monkeypatch.setattr(adapter, "_question_still_open", lambda *_: True)
+    interaction = _interaction(f"tq:{TASK}:{EPISODE}:1", user_id=OTHER_ID)
+
+    _run(adapter, interaction)
+
+    assert _ephemeral(interaction) == "Alleen de eigenaar kan deze vraag beantwoorden."
+    adapter.handle_message.assert_not_awaited()
+    interaction.message.edit.assert_not_awaited()
+    interaction.channel.edit.assert_not_awaited()
+
+
+def test_modal_submit_by_someone_else_is_refused(monkeypatch):
+    adapter = _adapter()
+    monkeypatch.setattr(adapter, "_question_still_open", lambda *_: True)
+    interaction = _modal_submit("ik ook", user_id=OTHER_ID)
+
+    _run(adapter, interaction)
+
+    assert _ephemeral(interaction) == "Alleen de eigenaar kan deze vraag beantwoorden."
+    adapter.handle_message.assert_not_awaited()
+
+
+def test_other_interactions_are_left_alone():

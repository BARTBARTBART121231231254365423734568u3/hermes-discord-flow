+# (d) the card no longer waits on this question --------------------------------------------------
+
+@pytest.fixture
+def board(tmp_path: Path, monkeypatch: pytest.MonkeyPatch):
+    from hermes_cli import kanban_db as kb
+    from hermes_cli import kanban_db_connect as kbc
+
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.delenv("HERMES_KANBAN_DB", raising=False)
+    monkeypatch.delenv("HERMES_KANBAN_BOARD", raising=False)
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    kb.init_db()
+
+    def ask(question: str = "Vraag voor de eigenaar: A of B?"):
+        with kbc.connect_closing() as conn:
+            tid = kb.create_task(conn, title="t", assignee="worker")
+            with kb.write_txn(conn):
+                conn.execute("UPDATE tasks SET status='ready' WHERE id=?", (tid,))
+            assert kb.claim_task(conn, tid, claimer="worker") is not None
+            assert kb.block_task(conn, tid, reason=question, kind="needs_input")
+            episode = conn.execute("SELECT MAX(id) FROM task_events WHERE task_id = ? AND kind = 'blocked'",
+                                   (tid,)).fetchone()[0]
+        return tid, str(episode)
+
+    def block(tid: str, reason: str) -> None:
+        with kbc.connect_closing() as conn:
+            assert kb.block_task(conn, tid, reason=reason)
+
+    def unblock(tid: str) -> None:
+        with kbc.connect_closing() as conn:
+            assert kb.unblock_task(conn, tid)
+
+    return SimpleNamespace(ask=ask, block=block, unblock=unblock)
+
+
+def _click(adapter, tid: str, episode: str, choice: str = "1"):
+    interaction = _interaction(f"tq:{tid}:{episode}:{choice}")
+    _run(adapter, interaction)
+    return interaction
+
+
+def test_board_check_accepts_the_open_question(board):
+    tid, episode = board.ask()
+    adapter = _adapter()
+    assert adapter._question_still_open(tid, episode)
+    _click(adapter, tid, episode)
+    assert _sent_text(adapter) == "Antwoord van de eigenaar (knop): optie 1 — Variant A"
+
+

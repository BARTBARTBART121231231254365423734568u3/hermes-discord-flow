diff --git a/tests/hermes_cli/test_kanban_wait_status.py b/tests/hermes_cli/test_kanban_wait_status.py
new file mode 100644
index 0000000000..66601307c2
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_wait_status.py
@@ -0,0 +1,72 @@
+"""Rewriting the reason of a blocked card to its wait state ("Wacht op …").
+
+After the owner answered, the card may stay blocked (e.g. waiting on a nightly run). The manager
+rewrites the reason so the answered question never looks open; status, block_kind and the loop
+counter must not change, and any other reason on a blocked card is still refused.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+
+
+@pytest.fixture
+def kanban_home(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> Path:
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    kb.init_db()
+    return home
+
+
+def _blocked_question(conn) -> str:
+    tid = kb.create_task(conn, title="t", assignee="worker")
+    with kb.write_txn(conn):
+        conn.execute("UPDATE tasks SET status='ready' WHERE id=?", (tid,))
+    assert kb.claim_task(conn, tid, claimer="worker") is not None
+    assert kb.block_task(conn, tid, reason="Vraag voor de eigenaar: A of B?", kind="needs_input")
+    return tid
+
+
+def _last_reason(conn, tid) -> str:
+    return [e for e in kb.list_events(conn, tid) if e.kind == "blocked"][-1].payload["reason"]
+
+
+def test_wait_status_rewrites_reason_only(kanban_home: Path) -> None:
+    with kbc.connect_closing() as conn:
+        tid = _blocked_question(conn)
+        before = kb.get_task(conn, tid)
+        assert kb.block_task(conn, tid, reason="Wacht op nachtrun 23:00 – antwoord A gegeven")
+        after = kb.get_task(conn, tid)
+        assert (after.status, after.block_kind, after.block_recurrences) == (
+            "blocked", before.block_kind, before.block_recurrences)
+        assert _last_reason(conn, tid).startswith("Wacht op nachtrun")
+
+
+def test_other_reason_on_blocked_card_still_refused(kanban_home: Path) -> None:
+    with kbc.connect_closing() as conn:
+        tid = _blocked_question(conn)
+        assert not kb.block_task(conn, tid, reason="Vraag voor de eigenaar: nog een vraag?", kind="needs_input")
+        assert _last_reason(conn, tid) == "Vraag voor de eigenaar: A of B?"
+
+
+def test_wait_status_with_other_kind_refused(kanban_home: Path) -> None:
+    with kbc.connect_closing() as conn:
+        tid = _blocked_question(conn)
+        assert not kb.block_task(conn, tid, reason="Wacht op iets", kind="capability")
+
+
+def test_wait_status_also_replaces_last_run_summary(kanban_home: Path) -> None:
+    with kbc.connect_closing() as conn:
+        tid = _blocked_question(conn)
+        assert kb.block_task(conn, tid, reason="Wacht op nachtrun – antwoord A gegeven")
+        summary = conn.execute("SELECT summary FROM task_runs WHERE task_id = ? ORDER BY id DESC LIMIT 1", (tid,)).fetchone()[0]
+        assert summary == "Wacht op nachtrun – antwoord A gegeven"
+        assert any((e.payload or {}).get("reason") == "Vraag voor de eigenaar: A of B?"
+                   for e in kb.list_events(conn, tid) if e.kind == "blocked")
